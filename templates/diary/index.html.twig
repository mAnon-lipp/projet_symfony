{% extends 'base.html.twig' %}

{% block title %}Your diary — trackd{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/home.css') }}">
{% endblock %}

{% block body %}
    <div class="trackd-page diary-page">
        <header class="site-header">
            <a class="brand" href="{{ path('app_diary') }}" aria-label="trackd diary">
                <span class="brand-mark"><img src="{{ asset('images/home/record.svg') }}" alt=""></span>
                <span>trackd</span>
            </a>

            <form class="search-box search-form" action="{{ path('catalog_search') }}" method="get" data-autocomplete-url="{{ path('api_catalog_autocomplete') }}">
                <img src="{{ asset('images/home/search.svg') }}" alt="">
                <input name="q" type="search" placeholder="Rechercher albums ou artistes…" aria-label="Rechercher albums ou artistes" autocomplete="off">
                <kbd>⌘K</kbd>
                <div class="autocomplete-results" role="listbox"></div>
            </form>

            <nav class="public-nav diary-nav" aria-label="Account navigation">
                <a class="active" href="{{ path('app_diary') }}">Diary</a>
                <a href="{{ path('app_home') }}">Explore</a>
                <a href="#lists">Lists</a>
            </nav>

            <div class="account-actions">
                <span class="diary-user">{{ app.user.username ?: app.user.userIdentifier }}</span>
                <a class="sign-in" href="{{ logout_path() }}">Log out</a>
            </div>
        </header>

        <main class="diary-content">
            <section class="diary-intro" aria-labelledby="diary-title">
                <div>
                    <p class="eyebrow">YOUR MUSIC JOURNAL</p>
                    <h1 id="diary-title">Diary</h1>
                    <p>Keep track of the albums you listened to.</p>
                </div>
                <span class="diary-count">{{ entries|length }} {{ entries|length == 1 ? 'album' : 'albums' }} logged</span>
            </section>

            <section class="diary-add-card" aria-labelledby="add-album-title">
                <div class="section-heading">
                    <div>
                        <h2 id="add-album-title">Add an album</h2>
                        <p>What did you listen to?</p>
                    </div>
                </div>

                {% for message in app.flashes('success') %}
                    <div class="diary-success" role="status">{{ message }}</div>
                {% endfor %}
                {% if form_errors %}
                    <div class="login-alert" role="alert">
                        <ul>
                            {% for error in form_errors %}<li>{{ error }}</li>{% endfor %}
                        </ul>
                    </div>
                {% endif %}

                <form method="post" class="diary-form">
                    <input type="hidden" name="_token" value="{{ csrf_token('diary_entry') }}">
                    <label class="diary-autocomplete-field" data-autocomplete-url="{{ path('api_catalog_autocomplete') }}" data-autocomplete-type="artist">
                        Artist
                        <input class="diary-artist-input" type="text" name="artist" value="{{ form_values.artist }}" placeholder="e.g. Radiohead" required autocomplete="off">
                        <div class="autocomplete-results" role="listbox"></div>
                    </label>
                    <label class="diary-autocomplete-field" data-autocomplete-url="{{ path('api_catalog_autocomplete') }}" data-autocomplete-type="album">
                        Album
                        <input class="diary-album-input" type="text" name="album" value="{{ form_values.album }}" placeholder="e.g. In Rainbows" required autocomplete="off">
                        <div class="autocomplete-results" role="listbox"></div>
                    </label>
                    <label>
                        Listened on
                        <input type="date" name="listened_at" value="{{ form_values.listened_at }}" required>
                    </label>
                    <fieldset class="rating-field">
                        <legend>Rating</legend>
                        <div class="star-rating">
                            {% for star in 1..5 %}
                                <label class="star-option">
                                    <input type="radio" name="rating" value="{{ star }}" {% if form_values.rating == star|number_format(0) %}checked{% endif %} required>
                                    <span aria-hidden="true">★</span>
                                    <span class="visually-hidden">{{ star }} star{{ star == 1 ? '' : 's' }}</span>
                                </label>
                            {% endfor %}
                        </div>
                    </fieldset>
                    <label class="comment-field">
                        Comment
                        <textarea name="comment" rows="2" placeholder="What did you think?">{{ form_values.comment }}</textarea>
                    </label>
                    <label class="favorite-field">
                        <input type="checkbox" name="is_favorite" value="1" {% if form_values.is_favorite %}checked{% endif %}>
                        Add to favorite albums
                    </label>
                    <button class="primary-button" type="submit">Add to diary</button>
                </form>
            </section>

            <section class="diary-list" aria-labelledby="recent-listens-title">
                <div class="section-heading">
                    <div>
                        <h2 id="recent-listens-title">Recent listens</h2>
                        <p>Your listening history, newest first</p>
                    </div>
                </div>

                {% if entries is empty %}
                    <div class="diary-empty">
                        <p>No albums in your diary yet.</p>
                        <span>Add your first listen above to start your journal.</span>
                    </div>
                {% else %}
                    <div class="diary-entries">
                        {% for entry in entries %}
                            <article class="diary-entry">
                                <div class="diary-entry-date">
                                    <strong>{{ entry.listenedAt|date('d') }}</strong>
                                    <span>{{ entry.listenedAt|date('M Y') }}</span>
                                </div>
                                {% if entry.albumId.coverUrl %}
                                    <img class="diary-entry-cover" src="{{ entry.albumId.coverUrl }}" alt="{{ entry.albumId.title }} cover">
                                {% else %}
                                    <div class="diary-entry-cover diary-entry-cover-placeholder" aria-hidden="true">♪</div>
                                {% endif %}
                                <div class="diary-entry-details">
                                    <h3>{{ entry.albumId.title }}</h3>
                                    <p>{{ entry.albumId.artist.name }} · {{ entry.albumId.genre.name }}</p>
                                    <div class="diary-entry-rating" aria-label="{{ entry.rating }} out of 5 stars">
                                        {% for star in 1..5 %}<span class="{{ star <= entry.rating ? 'is-filled' : '' }}">★</span>{% endfor %}
                                        {% if entry.isFavorite %}<span class="favorite-badge">Favorite</span>{% endif %}
                                    </div>
                                    {% if entry.comment %}
                                        <p class="diary-entry-comment">{{ entry.comment }}</p>
                                    {% endif %}
                                </div>
                                <a class="diary-edit-link" href="{{ path('app_diary_edit', {id: entry.id}) }}" aria-label="Edit {{ entry.albumId.title }}" title="Edit">
                                    <svg aria-hidden="true" viewBox="0 0 24 24" focusable="false">
                                        <path d="M4 20h4L19.5 8.5a2.1 2.1 0 0 0-3-3L5 17v3Zm11.5-13 1.5-1.5 2 2L17.5 9l-2-2Z"></path>
                                    </svg>
                                </a>
                            </article>
                        {% endfor %}
                    </div>
                {% endif %}
            </section>
        </main>
    </div>
    <script>
        (() => {
            const form = document.querySelector('.search-form'), input = form?.querySelector('input'), results = form?.querySelector('.autocomplete-results');
            if (!form || !input || !results) return;
            let timer;
            input.addEventListener('input', () => {
                clearTimeout(timer);
                const query = input.value.trim();
                if (query.length < 2) { results.replaceChildren(); return; }
                timer = setTimeout(async () => {
                    const response = await fetch(`${form.dataset.autocompleteUrl}?q=${encodeURIComponent(query)}`);
                    if (!response.ok) return;
                    results.replaceChildren(...(await response.json()).map(item => {
                        const link = document.createElement('a');
                        link.href = item.url; link.setAttribute('role', 'option');
                        const label = document.createElement('strong');
                        const meta = document.createElement('small');
                        label.textContent = item.label;
                        meta.textContent = item.type + (item.artist ? ` · ${item.artist}` : '');
                        link.append(label, meta);
                        return link;
                    }));
                }, 180);
            });
            document.addEventListener('click', event => { if (!form.contains(event.target)) results.replaceChildren(); });
        })();
    </script>
    <script>
        (() => {
            document.querySelectorAll('.diary-autocomplete-field').forEach(field => {
                const input = field.querySelector('input');
                const results = field.querySelector('.autocomplete-results');
                let timer;
                input.addEventListener('input', () => {
                    clearTimeout(timer);
                    const query = input.value.trim();
                    if (query.length < 2) { results.replaceChildren(); return; }
                    timer = setTimeout(async () => {
                        const response = await fetch(`${field.dataset.autocompleteUrl}?q=${encodeURIComponent(query)}&type=${field.dataset.autocompleteType}`);
                        if (!response.ok) return;
                        results.replaceChildren(...(await response.json()).map(item => {
                            const option = document.createElement('a');
                            option.href = '#';
                            option.setAttribute('role', 'option');
                            const label = document.createElement('strong');
                            const meta = document.createElement('small');
                            label.textContent = item.label;
                            meta.textContent = item.type + (item.artist ? ` · ${item.artist}` : '');
                            option.append(label, meta);
                            option.addEventListener('click', event => {
                                event.preventDefault();
                                input.value = item.label;
                                if (item.type === 'Album' && item.artist) {
                                    field.closest('form').querySelector('.diary-artist-input').value = item.artist;
                                }
                                results.replaceChildren();
                            });
                            return option;
                        }));
                    }, 180);
                });
                document.addEventListener('click', event => {
                    if (!field.contains(event.target)) results.replaceChildren();
                });
            });
        })();
    </script>
{% endblock %}
