{% extends 'base.html.twig' %}

{% block title %}Edit diary entry — trackd{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/home.css') }}">
{% endblock %}

{% block body %}
    <div class="trackd-page diary-page">
        <header class="site-header">
            <a class="brand" href="{{ path('app_home') }}" aria-label="trackd diary">
                <span class="brand-mark"><img src="{{ asset('images/home/record.svg') }}" alt=""></span>
                <span>trackd</span>
            </a>

            <nav class="public-nav diary-nav" aria-label="Account navigation">
                <a class="active" href="{{ path('app_diary') }}">Diary</a>
                <a href="{{ path('catalog_search') }}">Explore</a>
            </nav>

            <div class="account-actions">
                <a class="diary-user nav-account" href="{{ path('app_profile') }}" aria-label="{{ app.user.username ?: app.user.userIdentifier }}">
                    {% if app.user.avatarUrl %}
                        <img class="nav-avatar" src="{{ app.user.avatarUrl }}" alt="">
                    {% else %}
                        {{ app.user.username ?: app.user.userIdentifier }}
                    {% endif %}
                </a>
                <a class="sign-in" href="{{ logout_path() }}">Log out</a>
            </div>
        </header>

        <main class="diary-content">
            <section class="diary-add-card diary-edit-card" aria-labelledby="edit-entry-title">
                <div class="section-heading">
                    <div>
                        <p class="eyebrow">YOUR MUSIC JOURNAL</p>
                        <h1 id="edit-entry-title">Edit listen</h1>
                        <p>Update your rating, comment or favorite status.</p>
                    </div>
                </div>

                {% if diary_form.vars.errors|length > 0 %}
                    <div class="login-alert" role="alert">
                        {{ form_errors(diary_form) }}
                    </div>
                {% endif %}

                <div class="diary-edit-layout">
                    <div class="diary-edit-main">
                        <div class="diary-entry-details">
                            <h2>{{ entry.albumId.title }}</h2>
                            <p class="diary-readonly">{{ entry.albumId.artist.name }} · Listened on {{ entry.listenedAt|date('d/m/Y') }}</p>
                        </div>

                        {{ form_start(diary_form, {attr: {class: 'diary-form diary-edit-form'}}) }}
                            <fieldset class="rating-field">
                                <legend>Rating</legend>
                                <div class="star-rating">
                                    {% for choice in diary_form.rating %}
                                        <label class="star-option">
                                            {{ form_widget(choice) }}
                                            <span aria-hidden="true">★</span>
                                            <span class="visually-hidden">{{ loop.index }} star{{ loop.index == 1 ? '' : 's' }}</span>
                                        </label>
                                    {% endfor %}
                                </div>
                                {{ form_errors(diary_form.rating) }}
                            </fieldset>
                            <label class="comment-field">
                                Comment
                                {{ form_widget(diary_form.comment, {attr: {rows: 4, placeholder: 'What did you think?'}}) }}
                                {{ form_errors(diary_form.comment) }}
                            </label>
                            <label class="favorite-field">
                                {{ form_widget(diary_form.isFavorite) }}
                                Add to favorite albums
                            </label>
                            <button class="primary-button" type="submit">Save changes</button>
                        {{ form_end(diary_form) }}
                    </div>

                    {% if entry.albumId.coverUrl %}
                        <aside class="diary-edit-cover">
                            <img src="{{ entry.albumId.coverUrl }}" alt="{{ entry.albumId.title }} cover">
                        </aside>
                    {% endif %}
                </div>
            </section>
        </main>
    </div>
{% endblock %}
